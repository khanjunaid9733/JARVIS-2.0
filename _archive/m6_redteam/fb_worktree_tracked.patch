diff --git a/tests/conftest.py b/tests/conftest.py
index 6c830a0..03335d2 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -12,9 +12,23 @@ Pin the backend to ``asyncio`` so the async suite is deterministic across
 environments and requires no ``trio`` install.
 """
 
+import sys
+
 import pytest
 
 
+# Red-team finding F8: declare a hard interpreter gate, not a convention.
+# `requires-python = ">=3.12,<3.14"` (ADR-008) constrains *packaging*, but
+# pytest installed outside the venv ignores it. Fail fast with the remedy.
+if not (3, 12) <= sys.version_info[:2] < (3, 14):
+    pytest.exit(
+        f"FATAL: pytest is running under Python {sys.version.split()[0]}, "
+        "outside requires-python '>=3.12,<3.14' (ADR-008). Run the suite "
+        "through the project venv: 'uv sync' then 'uv run python -m pytest'.",
+        returncode=3,
+    )
+
+
 @pytest.fixture
 def anyio_backend():
     return "asyncio"
